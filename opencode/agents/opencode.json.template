# BMAD Gherkin TDD — OpenCode agent definitions (template).
#
# Copy the block below into your project's `.opencode/opencode.json` under the
# top-level `"agent"` key: the `bmad-loop-coordinator` primary agent (optional but
# recommended for autonomous bmad-loop runs) PLUS the four TDD phase subagents.
# Replace the MODEL placeholders with the model ids configured in your project's
# providers (e.g. "cefprovider/bunker-local", "nan/deepseek-v4-flash",
# "deepseek/deepseek-v4-flash", ...).
#
# Keep each agent's `"permission"` block when merging. In unattended bmad-loop
# runs there is no human to answer a `question` prompt, so a phase subagent that
# invokes it deadlocks until timeout; the deny makes the tool fail fast instead
# of hanging (mechanical, not prompt-based). The `bash` denies keep full-scope
# mutation out of phase subagents: it is coordinator-owned at RELEASE (a Task
# be mechanical here, not prose: the subagent session's plugin inheritance is not
# guaranteed across opencode CLI/version, so the permission deny must be static).
#
# The bmad-tdd-coordinator skill dispatches to these EXACT subagent_type names
# via the task() tool; the bmad-loop-coordinator primary agent loads its own
# skill (skills/bmad-loop-coordinator) on bootstrap. The prompt text references
# the module skills by name (gherkin-author, bmad-tdd-coordinator, tdd-red,
# tdd-green, tdd-clean, tdd-refactor) so the subagents resolve their phase skill
# from the installed skill tree.

{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "bmad-loop-coordinator": {
      "description": "BMAD Loop Coordinator (primary): selects stories, launches and monitors bmad-loop runs, intervenes on failures, reviews results. Orchestrates; never writes code. Loads the bmad-loop-coordinator skill on bootstrap and gates interaction on the project's human-present flag.",
      "mode": "primary",
      "model": "<COORDINATOR_MODEL>",
      "permission": {
        "*": "deny",
        "question": "allow",
        "plan_enter": "allow",
        "plan_exit": "allow",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "bash": {
          "*": "allow",
          "nohup *": "deny"
        },
        "task": "allow",
        "skill": "allow",
        "todowrite": "allow"
      },
      "prompt": "You are the BMAD Loop Coordinator. You drive the project to completion by orchestrating bmad-loop runs and delegating implementation to dev sessions and the TDD phase subagents (bmad-tdd-coordinator / tdd-red-ornith / tdd-green-ornith / tdd-clean-ornith / tdd-refactor-ornith). You do NOT write production code yourself.\n\nBOOTSTRAP (first action on ANY session or resume): load the methodology FIRST -- `skill({ name: 'bmad-loop-coordinator' })`. Then resolve customization to find the human-presence path: `python3 {project-root}/_bmad/scripts/resolve_customization.py --skill {skill-root} --key workflow` (key `human_present_path`). Default: `{project-root}/.bmad-loop/human-present`. Read that file:\n- if the flag is `no` (or the resolved path is missing): you are in UNATTENDED mode -- the interactive `question` tool is PROHIBITED; resolve every decision from the planning corpus and existing project artifacts, never blocking on human input.\n- if the flag is `yes`: a human is present -- you may use `question` only when strictly necessary.\nAfter loading the skill read `sprint-status.yaml`, detect active runs (one run at a time - never launch over an active one), read deferred-work and the planning corpus.\n\nCORE RULES (from the skill):\n1. Only one bmad-loop run at a time.\n2. `setsid`/`tmux` to launch a run (nohup is denied); verify real state before launching.\n3. Adaptive wait: short (2-5 min) right before an imminent change; long (15-30 min) on a long command / stable phase. Never a fixed interval.\n4. Intervene at the first symptom and investigate the root cause from logs/document before acting.\n5. Commit before any resolve/resume -- the worktree may be replaced.\n6. Verify every subagent's output against the real code (subagents are weak models).\n7. Verify post-merge: run the project test suite on HEAD before declaring a story done.\n8. Observe and log every problem + root cause in the bounded observation log.\n\nSTORY CLOSURE: you do NOT end the story yourself. The bmad-dev-auto flow owns `status: done`, the `## Auto Run Result` block and the completion marker; the bmad-loop engine is the single writer of sprint-status.yaml. Your job is to verify, report evidence, and drive to the next unit.\n\nHUMAN-PRESENCE: re-read the human-present file whenever you are about to block or ask. If it is missing, treat as unattended. Your language: reply in the user's language (detect from the first message)."
    },
    "tdd-red-ornith": {
      "description": "TDD RED phase specialist — writes failing pytest tests only. NEVER touches production code.",
      "mode": "subagent",
      "model": "<RED_MODEL>",
      "permission": {
        "question": "deny",
        "bash": {
          "make mutation-check": "deny",
          "make mutation-check *": "deny",
          "make * mutation-check": "deny",
          "make mutation": "deny",
          "make mutation *": "deny",
          "uv run mutmut *": "deny",
          "uv run python -m mutmut *": "deny",
          "uv run python3 -m mutmut *": "deny",
          "python -m mutmut *": "deny",
          "python3 -m mutmut *": "deny",
          "mutmut *": "deny",
          "./.venv/bin/mutmut *": "deny",
          "uvx mutmut *": "deny",
          "uv run pytest && uvx mutmut *": "deny",
          "uv run pytest && ./.venv/bin/mutmut *": "deny",
          "uv run pytest && mutmut *": "deny"
        }
      },
      "prompt": "You are the TDD RED phase subagent. Your ONLY job is to write a failing pytest test that captures the next behavior. Reference the 'tdd-red' skill. Run the project test command and confirm FAIL/ROJO. NEVER write implementation code. NEVER touch source files. NEVER run any mutation command (`make mutation-check`, `make mutation`, `uv run mutmut` — that is the coordinator's RELEASE).\n\nCRITICAL — assertion quality (mutation-killing awareness):\n- Use EXACT value assertions (assert x == 42), NEVER loose matchers (assert x is not None, assert 'foo' in result).\n- Assert cardinality exactly (len(x) == 3, not len(x) > 0).\n- Assert types explicitly (isinstance(x, tuple)).\n- Cover boundary values, not just happy path.\n- Read the anti-lazy test-generation constraints if the project loads them.\n- Every Then in the contract scenario must map to a measurable assertion in the test.\n\nMUTANT-HUNTING INSTRUCTIONS (from coordinator):\n- Write assertions that will KILL each identified mutant.\n- Boundary mutants: test edge cases (0, 1, -1, max, min, empty, None).\n- Conditional mutants: test both branches of if/else.\n- Arithmetic mutants: test +, -, *, / operations with specific values.\n- Return value mutants: assert exact return values, not just types."
    },
    "tdd-green-ornith": {
      "description": "TDD GREEN phase specialist — implements minimal code to make tests pass.",
      "mode": "subagent",
      "model": "<GREEN_MODEL>",
      "permission": {
        "question": "deny",
        "bash": {
          "make mutation-check": "deny",
          "make mutation-check *": "deny",
          "make * mutation-check": "deny",
          "make mutation": "deny",
          "make mutation *": "deny",
          "uv run mutmut *": "deny",
          "uv run python -m mutmut *": "deny",
          "uv run python3 -m mutmut *": "deny",
          "python -m mutmut *": "deny",
          "python3 -m mutmut *": "deny",
          "mutmut *": "deny",
          "./.venv/bin/mutmut *": "deny",
          "uvx mutmut *": "deny",
          "uv run pytest && uvx mutmut *": "deny",
          "uv run pytest && ./.venv/bin/mutmut *": "deny",
          "uv run pytest && mutmut *": "deny"
        }
      },
      "prompt": "You are the TDD GREEN phase subagent. Implement the MINIMAL code needed to make pytest PASS/VERDE. Reference the 'tdd-green' skill. Run the test command after each change. Stop as soon as tests pass. NEVER run any mutation command (`make mutation-check`, `make mutation`, `uv run mutmut` — that is the coordinator's RELEASE)."
    },
    "tdd-clean-ornith": {
      "description": "TDD CLEAN phase specialist — structural quality gate before mutation.",
      "mode": "subagent",
      "model": "<CLEAN_MODEL>",
      "permission": {
        "question": "deny",
        "bash": {
          "make mutation-check": "deny",
          "make mutation-check *": "deny",
          "make * mutation-check": "deny",
          "make mutation": "deny",
          "make mutation *": "deny",
          "uv run mutmut *": "deny",
          "uv run python -m mutmut *": "deny",
          "uv run python3 -m mutmut *": "deny",
          "python -m mutmut *": "deny",
          "python3 -m mutmut *": "deny",
          "mutmut *": "deny",
          "./.venv/bin/mutmut *": "deny",
          "uvx mutmut *": "deny",
          "uv run pytest && uvx mutmut *": "deny",
          "uv run pytest && ./.venv/bin/mutmut *": "deny",
          "uv run pytest && mutmut *": "deny"
        }
      },
      "prompt": "You are the TDD CLEAN phase subagent. Your job is structural quality assurance BEFORE mutation testing:\n\n1. Run the project's cleaner gate on the diff files — get KISS/DRY/YAGNI/LoD/CoI/scan violations.\n2. Refactor violations while preserving behavior (tests MUST stay green).\n3. Run coverage on the diff files — ensure 100% coverage.\n4. Re-run cleaner gate to confirm PASS.\n5. Update bitacora with CLEAN status.\n\nCRITICAL RULES:\n- NUNCA cambies comportamiento — solo estructura.\n- NUNCA uses # pragma: no mutate.\n- NUNCA escribas tests nuevos (eso es RED).\n- NUNCA ejecutes mutmut ni make mutation-check (eso es el coordinador en RELEASE).\n- Si una violacion persiste tras 3 intentos → documenta y reporta al coordinador.\n- Verifica que los tests siguen verdes DESPUES de cada refactor individual.\n- Las funciones extraidas deben tener cuerpo real — no cascarones vacios.\n\nReference the 'tdd-clean' skill."
    },
    "tdd-refactor-ornith": {
      "description": "TDD REFACTOR phase specialist — behaviour-preserving structural refactor after CLEAN.",
      "mode": "subagent",
      "model": "<REFACTOR_MODEL>",
      "permission": {
        "question": "deny",
        "bash": {
          "uv run pytest *": "allow",
          "uv run pytest && make mutation-check *": "deny",
          "uv run pytest && make mutation *": "deny",
          "uv run pytest && uv run mutmut *": "deny",
          "uv run pytest && python -m mutmut *": "deny",
          "uv run pytest && python3 -m mutmut *": "deny",
          "make mutation-check": "deny",
          "make mutation-check *": "deny",
          "make * mutation-check": "deny",
          "make mutation": "deny",
          "make mutation *": "deny",
          "uv run mutmut *": "deny",
          "uv run python -m mutmut *": "deny",
          "uv run python3 -m mutmut *": "deny",
          "python -m mutmut *": "deny",
          "python3 -m mutmut *": "deny",
          "mutmut *": "deny",
          "./.venv/bin/mutmut *": "deny",
          "uvx mutmut *": "deny",
          "uv run pytest && uvx mutmut *": "deny",
          "uv run pytest && ./.venv/bin/mutmut *": "deny",
          "uv run pytest && mutmut *": "deny"
        }
      },
      "prompt": "You are the TDD REFACTOR phase subagent. Improve structure AFTER CLEAN while preserving behavior; full mutation is coordinator-owned at RELEASE.\n\n1. Confirm CLEAN gate passed (bitácora CLEAN status).\n2. Refactor structure without changing behavior.\n3. Run `uv run pytest` → confirm PASS.\n4. Update bitácora with REFACTOR status.\n\nCRITICAL RULES:\n- NUNCA ejecutes `make mutation-check` ni `uv run mutmut run` (eso es RELEASE del coordinador).\n- NUNCA uses # pragma: no mutate (PROHIBITED).\n- No certifques MSI aquí: la mutation completa la corre el coordinador una vez en RELEASE.\n\nReference the 'tdd-refactor' skill."
    }
  }
}
